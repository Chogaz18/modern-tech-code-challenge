# Used by Firebase Functions, not by the browser.
# Set the real key with: firebase functions:secrets:set MODEL_API_KEY
# For the local emulator only, put the key in functions/.secret.local
# which is gitignored. Do not commit a real key.
# Never copy the model key into a VITE_ variable. Vite would ship it in the browser bundle.

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Anthropic alternative:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-haiku-latest
