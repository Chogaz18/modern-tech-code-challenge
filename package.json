{
  "name": "clearrow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && npm run typecheck --prefix functions",
    "preview": "vite preview",
    "test": "vitest run",
    "functions:build": "npm run build --prefix functions",
    "functions:typecheck": "npm run typecheck --prefix functions"
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "papaparse": "^5.5.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7"
  }
}
