# Browser Firebase config. These identify the Firebase project.
# They are not the model API key. Leave them blank to use ClearRow
# with deterministic checks only.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FUNCTIONS_EMULATOR=false

# Server-side model configuration lives in functions/.env and Firebase
# Secret Manager. Never put the model key in a VITE_ variable.
# See functions/.env.example and the README.
